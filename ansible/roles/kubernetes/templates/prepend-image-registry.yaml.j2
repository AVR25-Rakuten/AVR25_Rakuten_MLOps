apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: prepend-image-registry
  annotations:
    policies.kyverno.io/title: Prepend Image Registry
    policies.kyverno.io/category: Workload Management
    policies.kyverno.io/minversion: 1.6.0
    policies.kyverno.io/subject: Pod
    pod-policies.kyverno.io/autogen-controllers: "true"
spec:
  background: false
  rules:
    - name: prepend-registry
      match:
        any:
          - resources:
              kinds: ["Pod"]
      exclude:
        any:
          - resources:
              namespaces: ["kyverno"]
      mutate:
        foreach:
          - list: "request.object.spec.containers"
            preconditions:
              all:
                - key: "{{ element.image }}"
                  operator: NotMatches
                  value: "^{{ nfq_proxy_host }}/.*"
            patchStrategicMerge:
              spec:
                containers:
                  - name: "{{ element.name }}"
                    image: "{{ nfq_proxy_host }}/{{ element.image | regex_replace('^' ~ nfq_proxy_host ~ '/', '') }}"
          - list: "request.object.spec.initContainers"
            preconditions:
              all:
                - key: "{{ element.image }}"
                  operator: NotMatches
                  value: "^{{ nfq_proxy_host }}/.*"
            patchStrategicMerge:
              spec:
                initContainers:
                  - name: "{{ element.name }}"
                    image: "{{ nfq_proxy_host }}/{{ element.image | regex_replace('^' ~ nfq_proxy_host ~ '/', '') }}"
          - list: "request.object.spec.ephemeralContainers"
            preconditions:
              all:
                - key: "{{ element.image }}"
                  operator: NotMatches
                  value: "^{{ nfq_proxy_host }}/.*"
            patchStrategicMerge:
              spec:
                ephemeralContainers:
                  - name: "{{ element.name }}"
                    image: "{{ nfq_proxy_host }}/{{ element.image | regex_replace('^' ~ nfq_proxy_host ~ '/', '') }}"
